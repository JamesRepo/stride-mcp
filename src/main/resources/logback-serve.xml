<?xml version="1.0" encoding="UTF-8"?>

<!--
Serve mode's logging (set by logging.config in application-serve.properties). The other commands use Spring
Boot's default console logging.

No console appender: stdout carries MCP messages only. A plain file appender, not Boot's rolling one: rolling
would create new files with the default permissions (usually 644). PrivateLogFile makes the file 600 before
this opens it, and keeps it small by starting a new one at startup when it gets big.
-->
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<appender name="FILE" class="ch.qos.logback.core.FileAppender">
		<encoder>
			<pattern>${FILE_LOG_PATTERN}</pattern>
			<charset>${FILE_LOG_CHARSET}</charset>
		</encoder>
		<file>${LOG_FILE}</file>
	</appender>
	<root level="WARN">
		<appender-ref ref="FILE"/>
	</root>
</configuration>
